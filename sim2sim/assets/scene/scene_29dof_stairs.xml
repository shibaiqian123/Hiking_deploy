<mujoco model="g1_29dof stairs scene">
  <!-- Recreation of the original scene_29dof_stairs.xml: training-sized stairs
       (0.30 m tread / 0.075 m riser, same as the parkour training terrain).
       g1.xml / debug_axis.xml / meshes are symlinks to the shared G1 model data. -->
  <include file="debug_axis.xml"/>
  <!-- G1 body with Dex1 hand meshes/joints; keeps the staircase scene. -->
  <include file="g1_29dof_dex1_hands.xml"/>

  <statistic center="0 0 0.5" extent="2.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="stairs_groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="stairs_groundplane" texture="stairs_groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="stair_mat" rgba="0.55 0.55 0.6 1"/>
  </asset>

  <default>
    <geom friction="1.0"/>
  </default>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="stairs_floor" size="0 0 0.05" type="plane" material="stairs_groundplane"/>

    <!-- ascending flight: 8 steps, tread 0.30 m, riser 0.075 m, starts 1.0 m ahead -->
    <geom name="step_up_1" type="box" size="0.15 1.0 0.0375" pos="1.15 0 0.0375" material="stair_mat"/>
    <geom name="step_up_2" type="box" size="0.15 1.0 0.0750" pos="1.45 0 0.0750" material="stair_mat"/>
    <geom name="step_up_3" type="box" size="0.15 1.0 0.1125" pos="1.75 0 0.1125" material="stair_mat"/>
    <geom name="step_up_4" type="box" size="0.15 1.0 0.1500" pos="2.05 0 0.1500" material="stair_mat"/>
    <geom name="step_up_5" type="box" size="0.15 1.0 0.1875" pos="2.35 0 0.1875" material="stair_mat"/>
    <geom name="step_up_6" type="box" size="0.15 1.0 0.2250" pos="2.65 0 0.2250" material="stair_mat"/>
    <geom name="step_up_7" type="box" size="0.15 1.0 0.2625" pos="2.95 0 0.2625" material="stair_mat"/>
    <geom name="step_up_8" type="box" size="0.15 1.0 0.3000" pos="3.25 0 0.3000" material="stair_mat"/>

    <!-- top platform at 0.6 m, 1.2 m deep -->
    <geom name="platform_top" type="box" size="0.60 1.0 0.3000" pos="4.00 0 0.3000" material="stair_mat"/>

    <!-- descending flight back to the ground -->
    <geom name="step_dn_1" type="box" size="0.15 1.0 0.2625" pos="4.75 0 0.2625" material="stair_mat"/>
    <geom name="step_dn_2" type="box" size="0.15 1.0 0.2250" pos="5.05 0 0.2250" material="stair_mat"/>
    <geom name="step_dn_3" type="box" size="0.15 1.0 0.1875" pos="5.35 0 0.1875" material="stair_mat"/>
    <geom name="step_dn_4" type="box" size="0.15 1.0 0.1500" pos="5.65 0 0.1500" material="stair_mat"/>
    <geom name="step_dn_5" type="box" size="0.15 1.0 0.1125" pos="5.95 0 0.1125" material="stair_mat"/>
    <geom name="step_dn_6" type="box" size="0.15 1.0 0.0750" pos="6.25 0 0.0750" material="stair_mat"/>
    <geom name="step_dn_7" type="box" size="0.15 1.0 0.0375" pos="6.55 0 0.0375" material="stair_mat"/>
  </worldbody>
</mujoco>
